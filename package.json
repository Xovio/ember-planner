{
  "name": "ember-planner",
  "productName": "Ember Planner",
  "version": "0.8.0",
  "description": "Kalender, ToDos und Planung – Desktop-App",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "web": "vite --config vite.web.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node --no-warnings scripts/make-icon.mts",
    "pack": "electron-vite build && electron-builder --win dir",
    "dist": "electron-vite build && electron-builder --win nsis",
    "release": "electron-vite build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.11",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "author": "Ember Planner",
  "build": {
    "appId": "de.ember.planner",
    "productName": "Ember Planner",
    "copyright": "MIT-Lizenz",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ember Planner",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Ember-Planner-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Xovio",
        "repo": "ember-planner",
        "releaseType": "draft"
      }
    ]
  }
}
